{
  "ConnectionStrings": {
    "DefaultConnection": "Host=#{DB_HOST}#;Port=#{DB_PORT}#;Database=#{DB_NAME}#;Username=#{DB_USER}#;Password=#{DB_PASSWORD}#;SSL Mode=Require;Trust Server Certificate=false;Pooling=true;Minimum Pool Size=5;Maximum Pool Size=100"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Error",
        "Microsoft.EntityFrameworkCore.Database.Command": "Error",
        "System": "Warning",
        "EduTrack": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/edutrack-prod-.json",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithExceptionDetails"
    ],
    "Properties": {
      "Application": "EduTrack.Api",
      "Environment": "Production"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "HealthChecks": {
    "UI": {
      "EvaluationTimeinSeconds": 30,
      "MinimumSecondsBetweenFailureNotifications": 300
    }
  },
  "ErrorHandling": {
    "IncludeExceptionDetails": false,
    "IncludeStackTrace": false
  },
  "Resilience": {
    "Database": {
      "MaxRetryCount": 5,
      "MaxRetryDelay": "00:01:00",
      "CommandTimeout": "00:00:60"
    },
    "Http": {
      "Timeout": "00:00:60",
      "MaxRetryCount": 5,
      "CircuitBreakerThreshold": 10,
      "CircuitBreakerDuration": "00:02:00"
    }
  },
  "Seq": {
    "ServerUrl": "#{SEQ_SERVER_URL}#",
    "ApiKey": "#{SEQ_API_KEY}#"
  },
  "AllowedHosts": "#{ALLOWED_HOSTS}#"
}
